# 이 파일을 복사해 .env로 만들고 값을 채웁니다. 실제 값은 .env에만 적고 Git에 올리지 않습니다.

# 실행 환경
APP_ENV=development

# 데이터베이스 주소 (기본은 개발·테스트용 SQLite 파일, Phase 5부터 Supabase 주소로 바꿀 수 있음)
DATABASE_URL=sqlite:///database/buildlog.test.sqlite3

# 로그인 토큰을 만들 때 쓰는 비밀 키 (길고 무작위인 값을 직접 생성해서 입력)
SECRET_KEY=

# 서버가 요청을 허용할 화면 주소 (여러 개면 쉼표로 구분)
CORS_ORIGINS=http://localhost:5173

# (선택) 로그인 상태를 유지하는 시간(분). 비워 두면 기본값 10080(7일)
# ACCESS_TOKEN_EXPIRE_MINUTES=10080
